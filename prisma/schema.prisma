
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum UserRole {
  patient
  doctor
  admin
}

model User {
  id         Int            @id @default(autoincrement())
  username   String         @unique
  email      String         @unique
  password   String
  role       UserRole       @default(patient)
  fullName   String         @map("full_name")
  phone      String?
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")

  // Add the back-reference relation here
  doctorProfile DoctorProfile? // Optional one-to-one relation to DoctorProfile

  @@map("users")
}

model DoctorProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique // Unique constraint ensures one-to-one
  specialization   String
  bio              String?
  consultationFee  Float?
  experienceYears  Int?
  createdAt        DateTime @default(now())

  // This relation field links the DoctorProfile to a User
  user User @relation(fields: [userId], references: [id])

  @@map("doctor_profiles")
}