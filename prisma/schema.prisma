
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum UserRole {
  patient
  doctor
  admin
}

model User {
  id         Int            @id @default(autoincrement())
  username   String         @unique
  email      String         @unique
  password   String
  role       UserRole       @default(patient)
  fullName   String         @map("full_name")
  phone      String?
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")

  // Add the back-reference relation here
  doctorProfile DoctorProfile? // Optional one-to-one relation to DoctorProfile

  schedules Schedule[]

  @@map("users")
}

model DoctorProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique // Unique constraint ensures one-to-one
  specialization   String
  bio              String?
  consultationFee  Float?
  experienceYears  Int?
  createdAt        DateTime @default(now())

  // This relation field links the DoctorProfile to a User
  user User @relation(fields: [userId], references: [id])

  @@map("doctor_profiles")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

model Schedule {
  id           Int       @id @default(autoincrement())
  doctorId     Int       @map("doctor_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time") // "HH:mm"
  endTime      String    @map("end_time")   // "HH:mm"
  isAvailable  Boolean   @default(true) @map("is_available")

  doctor User @relation(fields: [doctorId], references: [id])

  @@map("schedules")
}