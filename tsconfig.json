{
  "compilerOptions": {
    "target": "ES2023",
    //"moduleResolution": "bundler",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_module", ".yarn"]
}
