# ── Server ───────────────────────────────────────────────────────
# Port the API listens on. On hosts like Render this is provided
# automatically, so you usually don't need to set it in production.
PORT=5000

# URL of the frontend allowed by CORS (see src/server.ts).
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────
# DATABASE_URL is used by the Prisma CLI for migrations (prisma migrate / db push)
# AND, since it takes precedence, by the app at runtime (see src/lib/prisma.ts).
# Setting just this one var is the simplest correct configuration — especially on
# hosts like Render, where six separate vars are easy to get subtly wrong.
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME?sslaccept=strict
# TiDB Cloud uses port 4000 and requires TLS; keep ?sslaccept=strict for it.
# URL-encode any @ : / or # characters in the password.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DB_NAME?sslaccept=strict

# Optional alternative to DATABASE_URL. These are used ONLY when DATABASE_URL is
# unset. TLS is inferred from the host (on for anything but localhost), so
# DATABASE_SSL only needs setting to override that.
# DATABASE_HOST=localhost
# DATABASE_PORT=3306        # local MySQL: 3306 — TiDB Cloud: 4000
# DATABASE_USER=root
# DATABASE_PASSWORD=changeme
# DATABASE_NAME=sams_db
# DATABASE_SSL=true         # accepts true/1/yes/on, any capitalisation

# ── Auth ─────────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# ── Google OAuth ─────────────────────────────────────────────────
# OAuth 2.0 Web application client ID from Google Cloud Console
# (APIs & Services → Credentials). The API uses it as the expected
# "audience" when verifying ID tokens, which is what prevents a token
# issued for another app from being accepted here.
# Must be the SAME client ID the frontend uses as AUTH_GOOGLE_ID.
# The client SECRET is only needed by the frontend, not here.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
