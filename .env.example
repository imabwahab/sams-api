# ── Server ───────────────────────────────────────────────────────
# Port the API listens on. On hosts like Render this is provided
# automatically, so you usually don't need to set it in production.
PORT=5000

# URL of the frontend allowed by CORS (see src/server.ts).
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────
# DATABASE_URL is used by the Prisma CLI for migrations (prisma migrate / db push).
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME?sslaccept=strict
# For hosted MySQL/TiDB keep the ?sslaccept=strict suffix; for local MySQL drop it.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DB_NAME

# The app connects at runtime using these individual vars (see src/lib/prisma.ts).
DATABASE_HOST=localhost
DATABASE_PORT=3306          # local MySQL: 3306 — TiDB Cloud: 4000
DATABASE_USER=root
DATABASE_PASSWORD=changeme
DATABASE_NAME=sams_db
DATABASE_SSL=false          # set to "true" for TiDB Cloud / any hosted MySQL that requires TLS

# ── Auth ─────────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string
